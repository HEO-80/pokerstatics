# Copiar a .env para local, o cargar como variables de entorno en Render.

# Local: mongodb://localhost:27017 (contenedor docker run mongo:7)
# Producción: connection string de MongoDB Atlas (mongodb+srv://...)
MONGO_URL=mongodb://localhost:27017
DB_NAME=prefloplab

# Dominio(s) del frontend permitidos por CORS, separados por coma.
# Local: http://localhost:3000
# Producción: https://<tu-proyecto>.vercel.app
CORS_ORIGINS=http://localhost:3000

GEMINI_API_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRE_DAYS=30
# false en local (http), true en producción (https, obligatorio en Render/Vercel)
COOKIE_SECURE=false
# lax en local; none en producción (frontend y backend en dominios distintos)
COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=

# Opcional (ver coach_persona.py). Vacío = comportamiento por defecto.
COACH_PERSONA=
