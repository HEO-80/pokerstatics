# Copiar a .env para local, o cargar como Environment Variables en Vercel
# (Project Settings → Environment Variables). Se incrustan en el build, así
# que un cambio requiere redeploy, no basta con recargar la página.

# Local: http://localhost:8000
# Producción: URL pública del servicio de Render, ej. https://pokerstatics-backend.onrender.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Mismo Client ID que backend GOOGLE_CLIENT_ID. En producción hace falta
# añadir el dominio de Vercel como "Authorized JavaScript origin" en
# Google Cloud Console (Credentials del OAuth Client ID).
REACT_APP_GOOGLE_CLIENT_ID=
